<Window x:Class="CafePOS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الكافيه الذكي"
        Icon="/Assets/app_icon.ico"
        WindowState="Maximized"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBeigeBrush}"
        FontFamily="{StaticResource AppFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Navigation Bar -->
        <Border DockPanel.Dock="Top" Height="48"
                Background="{StaticResource PrimaryBrownBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="☕" FontSize="20" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="إدارة الكافيه الذكي" FontSize="16"
                               FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button x:Name="BtnPOS" Content="🏪 نقطة البيع"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" Tag="POS"
                            Margin="1,0"/>

                    <Button x:Name="BtnReturns" Content="↩ المرتجعات"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" Tag="Returns"
                            Margin="1,0"/>

                    <Button x:Name="BtnInvoices" Content="📄 الفواتير"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" Tag="Invoices"
                            Margin="1,0"/>

                    <Button x:Name="BtnPurchases" Content="🛒 المشتريات"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" Tag="Purchases"
                            Margin="1,0"/>

                    <Button x:Name="BtnExpenses" Content="💸 المصروفات"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" Tag="Expenses"
                            Margin="1,0"/>

                    <!-- More button with popup -->
                    <Grid Margin="1,0">
                        <Button x:Name="MoreButton"
                                Content="☰ المزيد"
                                Style="{StaticResource NavButton}"
                                Click="MoreButton_Click"
                                Margin="1,0"/>
                        <Popup x:Name="MorePopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=MoreButton}"
                               StaysOpen="False"
                               PopupAnimation="Slide"
                               AllowsTransparency="True">
                            <Border Background="White" CornerRadius="8"
                                    BorderBrush="{StaticResource AccentCopperBrush}"
                                    BorderThickness="1" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Button x:Name="BtnReports" Content="📊 التقارير"
                                            Style="{StaticResource NavPopupButton}"
                                            Tag="Reports" Click="NavButton_Click"/>
                                    <Button x:Name="BtnProducts" Content="📦 المنتجات"
                                            Style="{StaticResource NavPopupButton}"
                                            Tag="Products" Click="NavButton_Click"/>
                                    <Button x:Name="BtnWorkers" Content="👥 العمال"
                                            Style="{StaticResource NavPopupButton}"
                                            Tag="Workers" Click="NavButton_Click"/>
                                    <Button x:Name="BtnWorkerWithdrawals" Content="📊 سحبيات العمال"
                                            Style="{StaticResource NavPopupButton}"
                                            Tag="WorkerWithdrawals" Click="NavButton_Click"/>
                                    <Button x:Name="BtnSettings" Content="⚙ الإعدادات"
                                            Style="{StaticResource NavPopupButton}"
                                            Tag="Settings" Click="NavButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- User Info & Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <Border Background="#5D4037" CornerRadius="4"
                            Padding="8,3" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="RoleBadge" FontSize="11"
                                   Foreground="White"/>
                    </Border>

                    <TextBlock x:Name="UserGreeting"
                               Foreground="White" FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <Button x:Name="ShiftClose" Content="🔒 إغلاق الشفت"
                            Style="{StaticResource AccentButton}"
                            Click="ShiftClose_Click"
                            Margin="0,0,5,0" Padding="12,6"/>

                    <Button Content="🚪 تسجيل الخروج"
                            Style="{StaticResource NavButton}"
                            Click="Logout_Click"
                            Margin="0,0,10,0"/>

                    <Border Width="1" Height="25" Background="#5D4037" Margin="5,0,10,0"/>

                    <!-- Window State Buttons -->
                    <Button Content="🗕" Style="{StaticResource TitleBarBtn}" Click="Minimize_Click"/>
                    <Button x:Name="BtnState" Content="🗖" Style="{StaticResource TitleBarBtn}" Click="Maximize_Click"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ContentControl x:Name="ContentArea"
                        DockPanel.Dock="Bottom"/>
    </DockPanel>
</Window>
