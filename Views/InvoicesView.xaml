<UserControl x:Class="CafePOS.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CafePOS.Converters"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="DashedSep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Search & Invoices List -->
        <Border Grid.Column="0" Background="White" CornerRadius="16"
                Padding="20" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="سجل الفواتير والبحث"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           Margin="0,0,0,15"/>

                <!-- Search & Date Filter Bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             Style="{StaticResource RoundedTextBox}"
                             FontSize="14"
                             Tag="ابحث برقم الفاتورة أو اسم العميل..."
                             Margin="0,0,8,0"
                             KeyDown="SearchBox_KeyDown"/>

                    <DatePicker x:Name="DatePickerFilter" Grid.Column="1"
                                Width="140" Height="42"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                SelectedDateChanged="DatePickerFilter_SelectedDateChanged"/>
                    
                    <Button x:Name="BtnClearFilters" Grid.Column="2"
                            Content="إعادة ضبط"
                            Style="{StaticResource DangerButton}"
                            Height="42" Padding="15,0"
                            Click="ClearFilters_Click"/>
                </Grid>

                <!-- Invoices List -->
                <ListView x:Name="InvoicesList"
                          BorderThickness="0" Background="Transparent"
                          SelectionChanged="InvoicesList_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,3" Background="#FAFAFA" CornerRadius="8" x:Name="ItemBorder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrownBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="12" Foreground="#888" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding CashierName, StringFormat='الكاشير: {0}'}" FontSize="12" Foreground="#666"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCopperBrush}"
                                               VerticalAlignment="Center"
                                               FlowDirection="LeftToRight"
                                               Text="{Binding Total, StringFormat='{}{0:F2} ر.ي'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>

        <!-- RIGHT: Selected Invoice Detail Preview -->
        <Border Grid.Column="1" Background="White" CornerRadius="16"
                Padding="20" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            
            <Grid>
                <!-- Empty State (No Invoice Selected) -->
                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📄" FontSize="64" Foreground="#CCC" HorizontalAlignment="Center"/>
                    <TextBlock Text="الرجاء اختيار فاتورة من القائمة لعرض تفاصيلها" FontSize="14" Foreground="#888" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Invoice Detail Panel -->
                <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <!-- Action Bar (Bottom) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                        <Button x:Name="BtnReprint" Content="إعادة طباعة الفاتورة 🖨️"
                                Style="{StaticResource PrimaryButton}"
                                Height="48" Click="Reprint_Click"/>
                    </StackPanel>

                    <!-- Receipt Visual Representation -->
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="15" Background="#FAFAFA">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="مـعـايـنـة الـفـاتـورة" FontSize="12" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                
                                <TextBlock x:Name="DtlCafeName" Text="كافيه" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Courier New"/>
                                <TextBlock x:Name="DtlPhone" Text="الهاتف: 777777777" FontSize="11" HorizontalAlignment="Center" FontFamily="Courier New" Margin="0,2,0,0"/>
                                
                                <Border Style="{StaticResource DashedSep}"/>

                                <TextBlock x:Name="DtlInvoiceNum" Text="فاتورة رقم: " FontSize="11" Foreground="#333" FontFamily="Courier New"/>
                                <TextBlock x:Name="DtlOrderNum" Text="رقم الطلب: " FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrownBrush}" FontFamily="Courier New" Margin="0,3,0,0"/>
                                <TextBlock x:Name="DtlDate" Text="التاريخ: " FontSize="11" Foreground="#555" FontFamily="Courier New" Margin="0,3,0,0"/>
                                <TextBlock x:Name="DtlCashier" Text="الكاشير: " FontSize="11" Foreground="#555" FontFamily="Courier New" Margin="0,3,0,0"/>
                                <TextBlock x:Name="DtlCustomer" Text="العميل: " FontSize="11" Foreground="#555" FontFamily="Courier New" Margin="0,3,0,0" Visibility="Collapsed"/>

                                <Border Style="{StaticResource DashedSep}"/>

                                <!-- Items List -->
                                <ItemsControl x:Name="DtlItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="11" FontFamily="Courier New"/>
                                                    <TextBlock Text="{Binding Quantity, StringFormat=' ×{0}'}" FontSize="11" Foreground="#666" FontFamily="Courier New"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:F2}'}" FontSize="11" FontFamily="Courier New" FlowDirection="LeftToRight"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource DashedSep}"/>

                                <!-- Totals -->
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="المجموع الفرعي" FontSize="11" FontFamily="Courier New"/>
                                    <TextBlock x:Name="DtlSubtotal" Text="0.00 ر.ي" FontSize="11" HorizontalAlignment="Left" FlowDirection="LeftToRight" FontFamily="Courier New"/>
                                </DockPanel>
                                <DockPanel x:Name="DtlDiscountRow" Margin="0,2" Visibility="Collapsed">
                                    <TextBlock x:Name="DtlDiscountLabel" Text="الخصم" FontSize="11" Foreground="{StaticResource SuccessGreenBrush}" FontFamily="Courier New"/>
                                    <TextBlock x:Name="DtlDiscountAmount" Text="0.00 ر.ي" FontSize="11" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Left" FlowDirection="LeftToRight" FontFamily="Courier New"/>
                                </DockPanel>
                                
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="الإجمالي" FontSize="14" FontWeight="Bold" FontFamily="Courier New"/>
                                    <TextBlock x:Name="DtlTotal" Text="0.00 ر.ي" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrownBrush}" HorizontalAlignment="Left" FlowDirection="LeftToRight" FontFamily="Courier New"/>
                                </DockPanel>

                                <Border Style="{StaticResource DashedSep}"/>

                                <TextBlock x:Name="DtlFooter" Text="شكراً لزيارتكم" FontSize="11" Foreground="#666" HorizontalAlignment="Center" FontFamily="Courier New"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
