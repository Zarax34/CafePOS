<UserControl x:Class="CafePOS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Settings Forms -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
            <StackPanel>

                <!-- Header -->
                <TextBlock Text="⚙ إعدادات الكافيه"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           Margin="0,0,0,20"/>

                <!-- Cafe Info Section -->
                <Border Background="White" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="معلومات الكافيه" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}" Margin="0,0,0,15"/>

                        <TextBlock Text="اسم الكافيه" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#555" Margin="0,0,0,6"/>
                        <TextBox x:Name="CafeNameBox" Style="{StaticResource RoundedTextBox}"
                                 FontSize="14" Margin="0,0,0,12"
                                 TextChanged="ReceiptPreview_Changed"/>

                        <TextBlock Text="رقم الهاتف" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#555" Margin="0,0,0,6"/>
                        <TextBox x:Name="PhoneBox" Style="{StaticResource RoundedTextBox}"
                                 FontSize="14" FlowDirection="LeftToRight" Margin="0,0,0,12"
                                 TextChanged="ReceiptPreview_Changed"/>

                        <TextBlock Text="نص التذييل (أسفل الفاتورة)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#555" Margin="0,0,0,6"/>
                        <TextBox x:Name="FooterBox" Style="{StaticResource RoundedTextBox}"
                                 FontSize="14" Margin="0,0,0,12"
                                 TextChanged="ReceiptPreview_Changed"/>

                        <TextBlock Text="شعار الكافيه (PNG)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#555" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Left" Content="اختيار صورة"
                                    Style="{StaticResource AccentButton}"
                                    Click="SelectLogo_Click"
                                    Margin="8,0,0,0" Padding="15,8"/>
                            <Border DockPanel.Dock="Left" Width="80" Height="80" CornerRadius="6"
                                    BorderBrush="#DDD" BorderThickness="1" Margin="0,0,8,0">
                                <Image x:Name="LogoPreviewImg" MaxWidth="72" MaxHeight="72"
                                       Stretch="Uniform"/>
                            </Border>
                        </DockPanel>
                        <Border Height="1" Background="#EEE" Margin="0,0,0,12"/>

                        <TextBlock Text="الطابعة الحرارية" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#555" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,5">
                            <Button x:Name="BtnDetectPrinters" Content="🔍 كشف"
                                    FontSize="12" Padding="10,6" Cursor="Hand"
                                    Click="DetectPrinters_Click"
                                    DockPanel.Dock="Left" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="{StaticResource AccentCopperBrush}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource PrimaryBrownBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <ComboBox x:Name="PrinterCombo"
                                      FontSize="14" FlowDirection="LeftToRight"
                                      Text="اختيار طابعة..." IsEditable="True"/>
                        </DockPanel>
                        <TextBlock x:Name="PrinterStatusText" FontSize="11" Foreground="#999" Margin="0,0,0,5"/>
                        <Button x:Name="BtnTestPrint" Content="🖨 اختبار الطباعة"
                                FontSize="12" Padding="12,6" Cursor="Hand"
                                Click="TestPrint_Click" Margin="0,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#EFEBE9" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#D7CCC8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- License Activation Section -->
                <Border x:Name="LicenseSection" Background="White" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🔑 الترخيص" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}" Margin="0,0,0,15"/>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="حالة الترخيص:" FontSize="14"
                                       VerticalAlignment="Center" Foreground="#555"/>
                            <TextBlock x:Name="LicenseStatusText" Text="غير نشط"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource ErrorRedBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,4" Visibility="Collapsed">
                            <TextBlock Text="الفترة التجريبية:" FontSize="13"
                                       VerticalAlignment="Center" Foreground="#555"/>
                            <TextBlock x:Name="LicenseTrialText" FontSize="13"
                                       Foreground="{StaticResource AccentCopperBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="رقم الجهاز:" FontSize="12" Foreground="#888" Margin="0,8,0,2"/>
                        <Border Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="نسخ"
                                        Click="CopyHwId_Click"
                                        Padding="10,4" Margin="8,0,0,0"
                                        FontSize="12" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{StaticResource AccentCopperBrush}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="White"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background"
                                                            Value="{StaticResource LightCopperBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock x:Name="HardwareIdText"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrownBrush}"
                                           VerticalAlignment="Center"
                                           FlowDirection="LeftToRight"
                                           FontFamily="Consolas"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="مفتاح التفعيل:" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#555" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button Content="تفعيل"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ActivateLicense_Click"
                                    FontSize="14" Padding="20,8" Height="40"
                                    DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <TextBox x:Name="LicenseKeyBox"
                                     Style="{StaticResource RoundedTextBox}"
                                     FontSize="13" FontFamily="Consolas"
                                     FlowDirection="LeftToRight"
                                     Height="40"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Discount Section -->
                <Border Background="White" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="إعدادات الخصم" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}" Margin="0,0,0,15"/>

                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="تفعيل زر الخصم للكاشير" FontSize="14"
                                       VerticalAlignment="Center" Foreground="#555"/>
                            <CheckBox x:Name="DiscountEnabledCheck"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DockPanel>

                        <TextBlock Text="نسبة الخصم الثابتة (%)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#555" Margin="0,0,0,6"/>
                        <TextBox x:Name="DiscountPercentBox" Style="{StaticResource RoundedTextBox}"
                                 FontSize="14" FlowDirection="LeftToRight" Width="120"
                                 HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Printing Settings Section -->
                <Border Background="White" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="إعدادات الطباعة" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}" Margin="0,0,0,15"/>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="طباعة كصورة نقطية (للمحافظة على اتجاه الحروف العربية)"
                                       FontSize="14" VerticalAlignment="Center" Foreground="#555"
                                       TextWrapping="Wrap"/>
                            <CheckBox x:Name="RasterPrintCheck"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                      ToolTip="ينصح بتفعيله للطابعات الحرارية العربية">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="#999" Margin="22,-5,0,5">
                            عند تفعيله، ستُطبع الفاتورة كصورة لتعرض الحروف العربية بشكل صحيح
                        </TextBlock>

                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="إخفاء الفاتورة المصغرة (فاتورة مختصرة)"
                                       FontSize="14" VerticalAlignment="Center" Foreground="#555"/>
                            <CheckBox x:Name="CompactReceiptCheck"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="#999" Margin="22,-5,0,5">
                            عند التفعيل، ستُطبع فاتورة رئيسية فقط بدون الفاتورة المصغرة الملحقة
                        </TextBlock>

                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="عكس ألوان الفاتورة (أبيض بخلفية سوداء)"
                                       FontSize="14" VerticalAlignment="Center" Foreground="#555"/>
                            <CheckBox x:Name="InvertColorsCheck"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="#999" Margin="22,-5,0,0">
                            عند التفعيل، تُطبع الفاتورة بخلفية سوداء وكتابة بيضاء (للوضع الليلي)
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Payment Methods Section -->
                <Border Background="White" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock Text="طرق الدفع" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrownBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="+ إضافة طريقة" Style="{StaticResource AccentButton}"
                                        Click="AddPaymentMethod_Click" Margin="0,0,8,0"/>
                                <Button Content="حذف المحدد" Style="{StaticResource DangerButton}"
                                        Click="DeletePaymentMethod_Click" Padding="12,6" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>

                        <ListView x:Name="PaymentMethodsList" BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" Margin="0,2" Background="#FAFAFA" CornerRadius="8">
                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Returns Permission Section -->
                <Border Background="White" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="صلاحيات الكاشير" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}" Margin="0,0,0,15"/>

                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="السماح للكاشير بإضافة مرتجعات" FontSize="14"
                                       VerticalAlignment="Center" Foreground="#555"/>
                            <CheckBox x:Name="ReturnsEnabledCheck"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="#999" Margin="22,-5,0,0">
                            عند إلغاء التفعيل، سيتم إخفاء زر المرتجعات للكاشير
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- User Management Section -->
                <Border Background="White" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock Text="إدارة المستخدمين" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrownBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="+ مستخدم جديد" Style="{StaticResource AccentButton}"
                                        Click="AddUser_Click" Margin="0,0,8,0"/>
                                <Button Content="حذف المحدد" Style="{StaticResource DangerButton}"
                                        Click="DeleteUser_Click" Padding="12,6" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>

                        <ListView x:Name="UsersList" BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" Margin="0,2" Background="#FAFAFA"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Username}" FontSize="14"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock FontSize="12" Foreground="#888">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="كاشير"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStoreManager}" Value="True">
                                                                    <Setter Property="Text" Value="مدير محل"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsManager}" Value="True">
                                                                    <Setter Property="Text" Value="مدير"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       FontSize="12" Margin="10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="● نشط"/>
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="● معطل"/>
                                                                <Setter Property="Foreground" Value="#F44336"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="2" Content="تعديل"
                                                    FontSize="12" Padding="8,4" Margin="4,0"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    Click="EditUser_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="#D7CCC8" CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#BCAAA4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Grid.Column="3" FontSize="12" Padding="8,4" Margin="4,0"
                                                    Cursor="Hand" Tag="{Binding}"
                                                    Click="ToggleUserActive_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#E0E0E0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="تعطيل"/>
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Content" Value="تفعيل"/>
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Backup & Sync Section -->
                <Border Background="White" CornerRadius="16" Padding="25" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="النسخ الاحتياطي والمزامنة" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}" Margin="0,0,0,15"/>

                        <TextBlock Text="يمكنك تصدير جميع البيانات في ملف JSON واحد، واستيرادها في جهاز آخر بذكاء دون تكرار."
                                   FontSize="13" Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="📦 تصدير نسخة احتياطية"
                                    Style="{StaticResource AccentButton}"
                                    Click="ExportBackup_Click"
                                    Padding="18,10" FontSize="14" Margin="0,0,10,0"/>
                            <Button Content="📥 استيراد ومزامنة"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ImportBackup_Click"
                                    Padding="18,10" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <Button Content="حفظ جميع الإعدادات"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="18" Height="55"
                        Click="SaveSettings_Click"
                        Margin="0,0,0,30"/>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT COLUMN: Live Receipt Preview -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="16"
                    Padding="15" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="معاينة الفاتورة الحرارية" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrownBrush}"
                               Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <!-- Thermal Receipt Mockup -->
                <Border Background="#FEFEFE" CornerRadius="4" Padding="15,20"
                        BorderBrush="#DDD" BorderThickness="1">

                    <!-- Dashed top edge -->
                    <Border.Resources>
                        <Style x:Key="DashedSep" TargetType="Border">
                            <Setter Property="BorderBrush" Value="#CCC"/>
                            <Setter Property="BorderThickness" Value="0,1,0,0"/>
                            <Setter Property="Margin" Value="0,8,0,8"/>
                            <Setter Property="Height" Value="1"/>
                        </Style>
                    </Border.Resources>

                    <StackPanel>
                        <!-- Logo Preview -->
                        <Image x:Name="PreviewLogoImg" MaxWidth="160" MaxHeight="100"
                               Stretch="Uniform" HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                        <!-- Cafe Name -->
                        <TextBlock x:Name="PreviewCafeName" Text="كافيه"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Courier New"/>

                        <!-- Phone -->
                        <TextBlock x:Name="PreviewPhone" Text=""
                                   FontSize="12" Foreground="#666"
                                   HorizontalAlignment="Center"
                                   FlowDirection="LeftToRight"
                                   FontFamily="Courier New"/>

                        <Border Style="{StaticResource DashedSep}"/>

                        <!-- Invoice info -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رقم الفاتورة:"
                                       FontSize="11" Foreground="#555"
                                       FontFamily="Courier New" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="INV-20260630-001"
                                       FontSize="11" Foreground="#555"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                       FontFamily="Courier New" VerticalAlignment="Center"/>
                        </Grid>
