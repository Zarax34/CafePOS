<Window x:Class="CafePOS.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدير الكافيه"
        Icon="/Assets/app_icon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border CornerRadius="14" Background="{StaticResource BackgroundBeigeBrush}"
            Margin="15" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#3E2723"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrownBrush}"
                       FontFamily="{StaticResource AppFont}"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="PromptText" FontSize="14"
                       Foreground="#555"
                       FontFamily="{StaticResource AppFont}"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="ResponseBox" Style="{StaticResource RoundedTextBox}"
                     FontSize="14" Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء" Padding="20,8"
                        Click="Cancel_Click" Margin="8,0,0,0"
                        Cursor="Hand" FontFamily="{StaticResource AppFont}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#EEE" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#DDD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="تأكيد" Style="{StaticResource PrimaryButton}"
                        Padding="25,8" FontSize="14"
                        Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
