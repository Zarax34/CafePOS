<Window x:Class="CafePOS.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفعيل الترخيص"
        Icon="/Assets/app_icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="520" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Border CornerRadius="20"
            Background="{StaticResource BackgroundBeigeBrush}"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.3" Color="#3E2723"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Grid.Row="0" Content="✕"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="15,10,0,0" Width="32" Height="32"
                    FontSize="14" Foreground="#999"
                    Click="CloseButton_Click"
                    FlowDirection="LeftToRight">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="16"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        Margin="40,0,40,20">

                <!-- Icon -->
                <Border Width="80" Height="80" CornerRadius="40"
                        Background="{StaticResource AccentCopperBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="🔑" FontSize="36"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="تفعيل الترخيص"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           Margin="0,0,0,5"/>

                <!-- Trial info -->
                <TextBlock x:Name="TrialText"
                           FontSize="14"
                           Foreground="{StaticResource AccentCopperBrush}"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           Margin="0,0,0,20"/>

                <!-- Hardware ID -->
                <TextBlock Text="رقم الجهاز (أرسله للبائع):"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#555"
                           FontFamily="{StaticResource AppFont}"
                           Margin="0,0,0,6"/>

                <Border Background="White" BorderBrush="#DDD" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,20">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="نسخ"
                                Click="CopyHwId_Click"
                                Padding="10,4" Margin="8,0,0,0"
                                FontSize="12" Cursor="Hand"
                                FontFamily="{StaticResource AppFont}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{StaticResource AccentCopperBrush}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextBlock.Foreground="White"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{StaticResource LightCopperBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="HardwareIdText"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}"
                                   VerticalAlignment="Center"
                                   FlowDirection="LeftToRight"
                                   FontFamily="Consolas"/>
                    </DockPanel>
                </Border>

                <!-- License Key -->
                <TextBlock Text="مفتاح الترخيص:"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#555"
                           FontFamily="{StaticResource AppFont}"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="LicenseKeyBox"
                         Style="{StaticResource RoundedTextBox}"
                         FontSize="13" FontFamily="Consolas"
                         FlowDirection="LeftToRight"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="60"
                         Margin="0,0,0,8"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource ErrorRedBrush}"
                           FontSize="13"
                           FontFamily="{StaticResource AppFont}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"
                           Visibility="Collapsed"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="متابعة التجريب"
                            x:Name="TrialButton"
                            Click="ContinueTrial_Click"
                            Margin="8,0,0,0" Padding="20,10"
                            Cursor="Hand" FontFamily="{StaticResource AppFont}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#EEE" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#DDD"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="تفعيل"
                            Style="{StaticResource PrimaryButton}"
                            Click="Activate_Click"
                            FontSize="16" Padding="30,10"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
