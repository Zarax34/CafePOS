<UserControl x:Class="CafePOS.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CafePOS.Converters"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Disabled message -->
        <Grid x:Name="ReturnsDisabledMessage" Grid.ColumnSpan="2" Visibility="Collapsed"
              VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="White" CornerRadius="16" Padding="40">
                <StackPanel>
                    <TextBlock Text="⛔" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="المرتجعات معطلة حالياً" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrownBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,5"/>
                    <TextBlock Text="قام مدير النظام بتعطيل إمكانية إضافة المرتجعات للكاشير"
                               FontSize="14" Foreground="#888" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LEFT: Search & Original Invoice -->
        <Border x:Name="SearchPanel" Grid.Column="0" Background="White" CornerRadius="16"
                Padding="20" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="البحث عن فاتورة"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           Margin="0,0,0,15"/>

                <!-- Search Bar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <Button DockPanel.Dock="Left" Content="بحث"
                            Style="{StaticResource AccentButton}"
                            Click="SearchInvoice_Click"
                            Margin="8,0,0,0" Height="42" Padding="20,0"/>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource RoundedTextBox}"
                             FontSize="14"
                             FlowDirection="LeftToRight"
                             KeyDown="SearchBox_KeyDown"/>
                </DockPanel>

                <!-- Invoice Info -->
                <StackPanel x:Name="InvoiceInfoPanel" DockPanel.Dock="Top"
                            Visibility="Collapsed" Margin="0,0,0,10">
                    <Border Background="#FFF8E1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="InvNumberText" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrownBrush}"/>
                            <TextBlock x:Name="InvDateText" FontSize="13" Foreground="#666" Margin="0,3,0,0"/>
                            <TextBlock x:Name="InvTotalText" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource AccentCopperBrush}" Margin="0,3,0,0"/>
                            <TextBlock x:Name="InvCustomerText" FontSize="13" Foreground="#666" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Original Items -->
                <TextBlock DockPanel.Dock="Top" Text="أصناف الفاتورة الأصلية"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="#555" Margin="0,0,0,8"
                           x:Name="ItemsHeaderText" Visibility="Collapsed"/>

                <ListView x:Name="OriginalItemsList"
                          BorderThickness="0" Background="Transparent"
                          SelectionMode="Multiple"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" Background="#FAFAFA" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Foreground="#999"
                                                   FlowDirection="LeftToRight">
                                            <Run Text="{Binding Quantity}"/>
                                            <Run Text=" × "/>
                                            <Run Text="{Binding Price, StringFormat='{}{0:F2}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrownBrush}"
                                               VerticalAlignment="Center"
                                               FlowDirection="LeftToRight"
                                               Text="{Binding Subtotal, StringFormat='{}{0:F2} ر.ي'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>

        <!-- RIGHT: Return Form -->
        <Border x:Name="ProcessPanel" Grid.Column="1" Background="White" CornerRadius="16"
                Padding="20" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="تنفيذ المرتجع"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           Margin="0,0,0,15"/>

                <!-- Reason -->
                <TextBlock DockPanel.Dock="Top" Text="سبب الإرجاع"
                           FontSize="14" FontWeight="SemiBold" Foreground="#555"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="ReasonBox" DockPanel.Dock="Top"
                         Style="{StaticResource RoundedTextBox}"
                         Height="80" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontSize="14" Margin="0,0,0,15"/>

                <!-- Process Button -->
                <Button DockPanel.Dock="Bottom" Content="تنفيذ المرتجع والصرف النقدي"
                        Style="{StaticResource DangerButton}"
                        FontSize="16" Height="48"
                        Click="ProcessReturn_Click"
                        Margin="0,10,0,0"/>

                <!-- Summary -->
                <Border DockPanel.Dock="Bottom" Background="#FFF3E0" CornerRadius="8"
                        Padding="15" Margin="0,10,0,0"
                        x:Name="ReturnSummaryPanel" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="ملخص المرتجع" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ReturnItemsCountText" FontSize="14" Foreground="#555"/>
                        <TextBlock x:Name="ReturnTotalText" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource ErrorRedBrush}" Margin="0,5,0,0"
                                   FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Border>

                <!-- Recent Returns -->
                <TextBlock DockPanel.Dock="Top" Text="آخر المرتجعات اليوم"
                           FontSize="15" FontWeight="SemiBold" Foreground="#555"
                           Margin="0,10,0,8"/>

                <ListView x:Name="RecentReturnsList"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" Background="#FFF8E7" CornerRadius="8">
                                <DockPanel>
                                    <TextBlock FontSize="13" Foreground="#999"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               FlowDirection="LeftToRight"
                                               Text="{Binding TotalRefund, StringFormat='-{0:F2} ر.ي'}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="13"
                                                   FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                        <TextBlock Text="{Binding Reason}" FontSize="12"
                                                   Foreground="#888" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
