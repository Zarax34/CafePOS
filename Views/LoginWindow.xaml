<Window x:Class="CafePOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الكافيه الذكي - تسجيل الدخول"
        Icon="/Assets/app_icon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="480" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyConverter"
            xmlns:local="clr-namespace:CafePOS.Converters"/>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{StaticResource BackgroundBeigeBrush}"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.3" Color="#3E2723"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Grid.Row="0" Content="✕"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="15,10,0,0" Width="32" Height="32"
                    FontSize="14" Foreground="#999"
                    Click="CloseButton_Click"
                    FlowDirection="LeftToRight">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="16"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Main Content -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="50,0,50,30">

                <!-- Logo Circle -->
                <Border Width="100" Height="100"
                        CornerRadius="50"
                        Background="{StaticResource PrimaryBrownBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.25" Color="#3E2723"/>
                    </Border.Effect>
                    <TextBlock Text="☕"
                               FontSize="44"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="إدارة الكافيه الذكي"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           Margin="0,0,0,5"/>

                <!-- Subtitle -->
                <TextBlock Text="تسجيل الدخول"
                           FontSize="15"
                           Foreground="{StaticResource AccentCopperBrush}"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           Margin="0,0,0,35"/>

                <!-- Username Label -->
                <TextBlock Text="رقم الكاشير"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           FontFamily="{StaticResource AppFont}"
                           Margin="5,0,0,6"/>

                <!-- Username Input -->
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBox}"
                         Margin="0,0,0,18"/>

                <!-- Password Label -->
                <TextBlock Text="كلمة المرور"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           FontFamily="{StaticResource AppFont}"
                           Margin="5,0,0,6"/>

                <!-- Password Input -->
                <Border Background="White"
                        BorderBrush="{StaticResource AccentCopperBrush}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <PasswordBox x:Name="PasswordBox"
                                 FontFamily="{StaticResource AppFont}"
                                 FontSize="16"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                </Border>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorRedBrush}"
                           FontSize="13"
                           FontFamily="{StaticResource AppFont}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,15"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"/>

                <!-- Login Button -->
                <Button Content="دخول"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="20"
                        Height="50"
                        Margin="0,5,0,0"/>

                <!-- Footer -->
                <TextBlock Text="نظام نقاط البيع الذكي v1.0"
                           FontSize="11"
                           Foreground="#999"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           Margin="0,25,0,0"/>
            </StackPanel>
        </Grid>
    </Border>


</Window>
