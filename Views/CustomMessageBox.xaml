<Window x:Class="CafePOS.Views.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدير الكافيه"
        Icon="/Assets/app_icon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border CornerRadius="16" Background="{StaticResource BackgroundBeigeBrush}"
            Margin="15" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="#3E2723"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon Column -->
            <Border x:Name="IconBorder" Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                    Background="{StaticResource AccentCopperBrush}"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,15,0">
                <TextBlock x:Name="IconText" Text="ℹ" FontSize="26" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Content Column -->
            <StackPanel Grid.Column="1">
                <!-- Title -->
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           FontFamily="{StaticResource AppFont}"
                           Margin="0,0,0,10"/>

                <!-- Message -->
                <TextBlock x:Name="MessageText" FontSize="14" Foreground="#4E342E"
                           FontFamily="{StaticResource AppFont}"
                           TextWrapping="Wrap" LineHeight="20"
                           Margin="0,0,0,25"/>

                <!-- Buttons Panel -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnNo" Content="لا" Width="90" Padding="0,8"
                            Click="BtnNo_Click" Margin="8,0,0,0"
                            Cursor="Hand" FontFamily="{StaticResource AppFont}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#EEE" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#DDD"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnYes" Content="نعم" Style="{StaticResource PrimaryButton}"
                            Width="100" Padding="0,8" FontSize="14"
                            Click="BtnYes_Click"/>
                    <Button x:Name="BtnOk" Content="حسناً" Style="{StaticResource PrimaryButton}"
                            Width="100" Padding="0,8" FontSize="14"
                            Click="BtnOk_Click" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
