<UserControl x:Class="CafePOS.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Products List -->
        <Border Grid.Column="0" Background="White" CornerRadius="16"
                Padding="20" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <TextBlock Text="إدارة المنتجات" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrownBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="+ منتج جديد" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Left" Click="NewProduct_Click"/>
                </DockPanel>

                <!-- Categories Tabs -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="التصنيفات:" FontSize="14" Foreground="#666"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="+ تصنيف" FontSize="12" Padding="10,4"
                                Click="NewCategory_Click" Cursor="Hand"
                                Margin="10,0,5,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#EEE" CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#DDD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="⚙ إدارة التصنيفات" FontSize="12" Padding="10,4"
                                Click="ManageCategories_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#E3D5CA" CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#D7C4B0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <ItemsControl x:Name="CatFilterButtons">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>

                <!-- Products Table -->
                <ListView x:Name="ProductsList" BorderThickness="0"
                          Background="Transparent"
                          SelectionChanged="ProductsList_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,3"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FAFAFA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="#333"/>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="12"
                                                   Foreground="#999"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource AccentCopperBrush}"
                                               VerticalAlignment="Center" Margin="15,0"
                                               FlowDirection="LeftToRight"
                                               Text="{Binding Price, StringFormat='{}{0:F2} ر.ي'}"/>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0"
                                               FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="نشط"/>
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="معطل"/>
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Grid.Column="3" Content="تفعيل/تعطيل"
                                            FontSize="11" Padding="8,4" Cursor="Hand"
                                            Tag="{Binding Id}" Click="ToggleActive_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="#EEE"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#DDD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Column="4" Content="تعديل"
                                            FontSize="11" Padding="8,4" Cursor="Hand"
                                            Tag="{Binding}" Click="EditProduct_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="#E3D5CA"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#D7C4B0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Column="5" Content="حذف"
                                            FontSize="11" Padding="8,4" Cursor="Hand"
                                            Foreground="White" Margin="5,0,0,0"
                                            Tag="{Binding Id}" Click="DeleteProduct_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="#D32F2F"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#B71C1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>

        <!-- RIGHT: Add/Edit Form -->
        <Border Grid.Column="1" Background="White" CornerRadius="16"
                Padding="20" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="FormTitle" Text="إضافة منتج جديد"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           Margin="0,0,0,20"/>

                <TextBlock Text="اسم المنتج" FontSize="14" FontWeight="SemiBold"
                           Foreground="#555" Margin="0,0,0,6"/>
                <TextBox x:Name="ProductNameBox" Style="{StaticResource RoundedTextBox}"
                         FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Text="السعر" FontSize="14" FontWeight="SemiBold"
                           Foreground="#555" Margin="0,0,0,6"/>
                <TextBox x:Name="ProductPriceBox" Style="{StaticResource RoundedTextBox}"
                         FontSize="14" FlowDirection="LeftToRight" Margin="0,0,0,12"/>

                <TextBlock Text="التصنيف" FontSize="14" FontWeight="SemiBold"
                           Foreground="#555" Margin="0,0,0,6"/>
                <ComboBox x:Name="CategoryCombo" FontSize="14" FontFamily="{StaticResource AppFont}"
                          Padding="10,8" Margin="0,0,0,20"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <Button x:Name="SaveProductBtn" Content="حفظ المنتج"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveProduct_Click" Margin="0,0,0,8"/>

                <Button Content="مسح الحقول" Style="{StaticResource AccentButton}"
                        Click="ClearForm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
