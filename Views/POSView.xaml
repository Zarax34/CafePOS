<UserControl x:Class="CafePOS.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CafePOS.Converters"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToDiscountTextConverter x:Key="BoolToDiscountText"/>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Products (70%) -->
        <Border Grid.Column="0" Margin="0,0,10,0">
            <DockPanel>
                <!-- Category Tabs -->
                <ScrollViewer DockPanel.Dock="Top"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Disabled"
                               Margin="0,0,0,12">
                    <ListBox x:Name="CategoriesList"
                             ItemsSource="{Binding Categories}"
                             SelectedValuePath="Id"
                             SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bg" Background="#DDD"
                                                    CornerRadius="20"
                                                    Padding="18,8"
                                                    Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background"
                                                            Value="{StaticResource AccentCopperBrush}"/>
                                                    <Setter Property="TextBlock.Foreground" Value="White"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="bg" Property="Background" Value="#CCC"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Product Grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.AddToCartCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="5" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="card"
                                                    Width="145" Height="155"
                                                    Background="White"
                                                    CornerRadius="12"
                                                    Padding="10"
                                                    BorderThickness="1"
                                                    BorderBrush="#E0E0E0">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                                      Opacity="0.08" Color="Black"/>
                                                </Border.Effect>

                                                <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <!-- Product Icon -->
                                                    <Border Width="55" Height="55"
                                                            CornerRadius="28"
                                                            Background="#FFF3E0"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,0,0,8">
                                                        <TextBlock Text="☕" FontSize="26"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Product Name -->
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#4E342E"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="125"/>

                                                    <!-- Price -->
                                                    <TextBlock FontSize="14" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentCopperBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"
                                                               FlowDirection="LeftToRight">
                                                        <Run Text="{Binding Price, StringFormat='{}{0:F2}'}"/>
                                                        <Run Text=" ر.ي"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush"
                                                            Value="{StaticResource AccentCopperBrush}"/>
                                                    <Setter TargetName="card" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="card" Property="RenderTransformOrigin"
                                                            Value="0.5,0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- RIGHT PANEL: Invoice / Cart (30%) -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="16"
                Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="الفاتورة الحالية"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrownBrush}"/>
                    <Border Height="2" Background="{StaticResource AccentCopperBrush}"
                            Margin="0,8,0,0" CornerRadius="1"/>
                </StackPanel>

                <!-- Customer Name -->
                <TextBox DockPanel.Dock="Top"
                         Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBox}"
                         FontSize="14"
                         Margin="0,0,0,10">
                    <TextBox.Tag>اسم العميل (اختياري)</TextBox.Tag>
                </TextBox>

                <!-- Payment Method -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                    <TextBlock Text="طريقة الدفع" FontSize="13" Foreground="#555"
                               VerticalAlignment="Center" Margin="0,0,0,0"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}"
                              SelectedItem="{Binding SelectedPaymentMethod}"
                              DisplayMemberPath="Name"
                              FontSize="14" MinWidth="120"
                              HorizontalAlignment="Left"/>
                </DockPanel>

                <!-- Bottom: Totals + Buttons -->
                <StackPanel DockPanel.Dock="Bottom">

                    <!-- Subtotal -->
                    <DockPanel Margin="0,8,0,4">
                        <TextBlock Text="المجموع الفرعي" FontSize="14"
                                   Foreground="#666"/>
                        <TextBlock FontSize="14" Foreground="#666"
                                   HorizontalAlignment="Left"
                                   FlowDirection="LeftToRight"
                                   Text="{Binding Subtotal, StringFormat='{}{0:F2} ر.ي'}"/>
                    </DockPanel>

                    <!-- Discount (conditional) -->
                    <DockPanel Margin="0,0,0,4"
                               Visibility="{Binding IsDiscountApplied, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="14" Foreground="{StaticResource SuccessGreenBrush}">
                            <Run Text="خصم "/>
                            <Run Text="{Binding DiscountPercent, StringFormat='{}{0}%'}"/>
                        </TextBlock>
                        <TextBlock FontSize="14"
                                   Foreground="{StaticResource SuccessGreenBrush}"
                                   HorizontalAlignment="Left"
                                   FlowDirection="LeftToRight"
                                   Text="{Binding DiscountAmount, StringFormat='-{0:F2} ر.ي'}"/>
                    </DockPanel>

                    <!-- Separator -->
                    <Border Height="2" Background="#EEE" Margin="0,6"/>

                    <!-- Total -->
                    <DockPanel Margin="0,6,0,12">
                        <TextBlock Text="الإجمالي" FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}"/>
                        <TextBlock FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}"
                                   HorizontalAlignment="Left"
                                   FlowDirection="LeftToRight"
                                   Text="{Binding Total, StringFormat='{}{0:F2} ر.ي'}"/>
                    </DockPanel>

                    <!-- Discount Button -->
                    <Button Content="{Binding IsDiscountApplied,
                                Converter={StaticResource BoolToDiscountText}}"
                            Command="{Binding ApplyDiscountCommand}"
                            Style="{StaticResource AccentButton}"
                            FontSize="14"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsDiscountEnabled, Converter={StaticResource BoolToVis}}"/>

                    <!-- Complete Order Button -->
                    <Button Content="إنهاء الطلب ✓"
                            Command="{Binding CompleteOrderCommand}"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="22" Height="55"
                            Margin="0,0,0,6"/>

                    <!-- Clear Button -->
                    <Button Content="إلغاء الفاتورة"
                            Command="{Binding ClearCartCommand}"
                            Style="{StaticResource DangerButton}"
                            FontSize="13" Height="35"/>

                    <!-- Last Order Message -->
                    <TextBlock Text="{Binding LastOrderMessage}"
                               FontSize="12"
                               Foreground="{StaticResource SuccessGreenBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               FlowDirection="LeftToRight"/>

                    <!-- Printer Status Indicator -->
                    <Border CornerRadius="8" Background="#F5F5F5" Padding="8" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#D32F2F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPrinterOnline}" Value="True">
                                                <Setter Property="Fill" Value="#388E3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding PrinterStatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#555" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cart Items List -->
                <ListView ItemsSource="{Binding CartItems}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,5">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,10" Margin="0,2"
                                    Background="#FAFAFA" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Product Name & Price -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#333"/>
                                         <TextBlock FontSize="12" Foreground="#999"
                                                    FlowDirection="LeftToRight"
                                                    Text="{Binding Price, StringFormat='{}{0:F2} ر.ي'}"/>
                                    </StackPanel>

                                    <!-- Quantity Controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="10,0">
                                        <Button Content="−" Width="28" Height="28"
                                                FontSize="16" FontWeight="Bold"
                                                Command="{Binding DataContext.DecrementCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="#EEE"
                                                            CornerRadius="14"
                                                            Width="28" Height="28">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg"
                                                                    Property="Background" Value="#DDD"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <TextBlock Text="{Binding Quantity}"
                                                   FontSize="16" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"
                                                   MinWidth="20"
                                                   TextAlignment="Center"/>

                                        <Button Content="+" Width="28" Height="28"
                                                FontSize="16" FontWeight="Bold"
                                                Command="{Binding DataContext.IncrementCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg"
                                                            Background="{StaticResource AccentCopperBrush}"
                                                            CornerRadius="14"
                                                            Width="28" Height="28">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          TextBlock.Foreground="White"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background"
                                                                    Value="{StaticResource LightCopperBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <!-- Item Subtotal + Remove -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrownBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FlowDirection="LeftToRight"
                                                   Text="{Binding Subtotal, StringFormat='{}{0:F2}'}"/>

                                        <Button Content="✕"
                                                Command="{Binding DataContext.RemoveFromCartCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand" FontSize="12">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="10" Width="22" Height="22">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          TextBlock.Foreground="#CCC"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background"
                                                                    Value="#FFEBEE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
