<Window x:Class="CafePOS.Views.ManageCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة التصنيفات"
        Icon="/Assets/app_icon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="500" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border CornerRadius="20" Background="{StaticResource BackgroundBeigeBrush}"
            Margin="15" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="#3E2723"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Content="✕" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="32" Height="32" FontSize="14" Foreground="#999"
                    Click="Close_Click" FlowDirection="LeftToRight">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="16"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Header -->
            <TextBlock Text="📁 إدارة التصنيفات" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrownBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Add/Edit form -->
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" Text="إضافة تصنيف جديد" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrownBrush}" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button x:Name="SaveBtn" DockPanel.Dock="Left" Content="حفظ" Style="{StaticResource PrimaryButton}"
                                    Padding="20,0" Height="40" Margin="8,0,0,0" Click="Save_Click"/>
                            <Button x:Name="CancelBtn" DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource AccentButton}"
                                    Padding="15,0" Height="40" Margin="8,0,0,0" Click="Cancel_Click" Visibility="Collapsed"/>
                            <TextBox x:Name="CategoryNameBox" Style="{StaticResource RoundedTextBox}" FontSize="14" Height="40"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Categories list -->
                <ListView Grid.Row="1" x:Name="CategoriesList" BorderThickness="0" Background="Transparent"
                          SelectionChanged="CategoriesList_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" Margin="0,2" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="15,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="نشط"/>
                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="معطل"/>
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Grid.Column="2" Content="تفعيل/تعطيل" FontSize="11" Padding="8,4" Cursor="Hand"
                                            Tag="{Binding}" Click="ToggleActive_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="#EEE" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#DDD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>
    </Border>
</Window>
