<UserControl x:Class="CafePOS.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFont}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Products -->
        <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="اختيار المنتجات للمشتريات"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           Margin="0,0,0,15"/>

                <!-- Quick Add Product -->
                <Border DockPanel.Dock="Top" Background="#FFF8E1" CornerRadius="10" Padding="14" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Text="➕ إضافة منتج جديد" FontSize="13" FontWeight="Bold"
                                   Foreground="#F57F17" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="NewProductName"
                                 Style="{StaticResource RoundedTextBox}"
                                 FontSize="13" Margin="0,0,4,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewProductPrice"
                                 Style="{StaticResource RoundedTextBox}"
                                 FontSize="13" Margin="4,0,4,0"
                                 FlowDirection="LeftToRight"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="إضافة"
                                FontSize="13" FontWeight="Bold" Height="36" Width="80"
                                Background="{StaticResource AccentCopperBrush}" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="AddNewProduct_Click"/>
                    </Grid>
                </Border>

                <!-- Products List -->
                <ListView x:Name="ProductsList"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,3" Background="#FAFAFA" CornerRadius="8"
                                    Cursor="Hand" MouseLeftButtonUp="ProductCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36"
                                            Background="{StaticResource BackgroundBeigeBrush}"
                                            CornerRadius="18" Margin="0,0,12,0">
                                        <TextBlock Text="📦" FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#444"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource AccentCopperBrush}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Price, StringFormat='سعر البيع: {0:F2} ر.ي'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPurchaseOnly}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Price, StringFormat='سعر التكلفة: {0:F2} ر.ي'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="➕"
                                               FontSize="18" Foreground="{StaticResource SuccessGreenBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Right: Cart -->
        <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="20" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="فاتورة المشتريات"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           Margin="0,0,0,12"/>

                <!-- Supplier + Notes -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="اسم المورد" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
                    <TextBox x:Name="SupplierBox" Style="{StaticResource RoundedTextBox}"
                             FontSize="14" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="ملاحظات" FontSize="12" Foreground="#888" Margin="0,8,0,4"/>
                    <TextBox x:Name="NotesBox" Style="{StaticResource RoundedTextBox}"
                             FontSize="14" HorizontalAlignment="Stretch" Height="60"
                             AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Cart items -->
                <ListView Grid.Row="2"
                          x:Name="CartList"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9F7F5" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#444"/>

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Subtotal, StringFormat={}{0:F2}}" FontSize="14"
                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrownBrush}"
                                               FlowDirection="LeftToRight"/>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="الكمية:" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                                        <Button Content="−" FontSize="14" Width="28" Height="28" Margin="4,0"
                                                Cursor="Hand" Click="Decrement_Click"
                                                Background="{StaticResource LightCopperBrush}"
                                                Foreground="White" BorderThickness="0"/>
                                        <TextBlock Text="{Binding Quantity}" FontSize="14" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="4,0" MinWidth="20"
                                                   TextAlignment="Center"/>
                                        <Button Content="+" FontSize="14" Width="28" Height="28" Margin="4,0"
                                                Cursor="Hand" Click="Increment_Click"
                                                Background="{StaticResource AccentCopperBrush}"
                                                Foreground="White" BorderThickness="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="التكلفة:" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CostPrice, Mode=TwoWay, StringFormat={}{0:F2}}" FontSize="13"
                                                 Width="70" TextAlignment="Center"
                                                 FlowDirection="LeftToRight"
                                                 VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <Button Content="✕" FontSize="12" Width="28" Height="28" Margin="4,0,0,0"
                                                Cursor="Hand" Click="RemoveItem_Click"
                                                Background="#E57373" Foreground="White" BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Total -->
                <Border Grid.Row="3" Background="{StaticResource PrimaryBrownBrush}" CornerRadius="10"
                        Padding="15" Margin="0,10,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الإجمالي:" FontSize="18" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="TotalText" Text="0.00" FontSize="22"
                                   FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Left" FlowDirection="LeftToRight"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Save Button -->
                <Button Grid.Row="4" Content="💾 حفظ فاتورة المشتريات"
                        FontSize="16" FontWeight="Bold" Height="50"
                        Style="{StaticResource PrimaryButton}"
                        Click="SavePurchase_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
