<Window x:Class="CafePOS.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مستخدم جديد"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="420" Height="550"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border CornerRadius="16" Background="{StaticResource BackgroundBeigeBrush}"
            Margin="15" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="#3E2723"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="👤 إضافة مستخدم جديد" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrownBrush}"
                       FontFamily="{StaticResource AppFont}"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Username -->
            <TextBlock Text="اسم المستخدم (رقم الكاشير لتسجيل الدخول):" FontSize="14" FontWeight="SemiBold"
                       Foreground="#555" FontFamily="{StaticResource AppFont}" Margin="5,0,0,6"/>
            <TextBox x:Name="UsernameBox" Style="{StaticResource RoundedTextBox}"
                     FontSize="14" Margin="0,0,0,12"/>

            <!-- FullName -->
            <TextBlock Text="اسم الكاشير (المعروض في الشريط العلوي والفواتير):" FontSize="14" FontWeight="SemiBold"
                       Foreground="#555" FontFamily="{StaticResource AppFont}" Margin="5,0,0,6"/>
            <TextBox x:Name="FullNameBox" Style="{StaticResource RoundedTextBox}"
                     FontSize="14" Margin="0,0,0,12"/>

            <!-- Password -->
            <TextBlock Text="كلمة المرور:" FontSize="14" FontWeight="SemiBold"
                       Foreground="#555" FontFamily="{StaticResource AppFont}" Margin="5,0,0,6"/>
            <Border Background="White" BorderBrush="{StaticResource AccentCopperBrush}" BorderThickness="1.5"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,15">
                <PasswordBox x:Name="PasswordBox" BorderThickness="0" Background="Transparent"
                             FontFamily="{StaticResource AppFont}" FontSize="16"/>
            </Border>

            <!-- Role Select -->
            <TextBlock Text="نوع الحساب (الصلاحية):" FontSize="14" FontWeight="SemiBold"
                       Foreground="#555" FontFamily="{StaticResource AppFont}" Margin="5,0,0,6"/>
            <ComboBox x:Name="RoleCombo" FontSize="14" FontFamily="{StaticResource AppFont}"
                      Padding="10,8" Margin="0,0,0,25" SelectedIndex="0">
                <ComboBoxItem Content="كاشير (صلاحيات بيع)" Tag="cashier"/>
                <ComboBoxItem Content="مدير (صلاحيات كاملة)" Tag="manager"/>
            </ComboBox>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="رجوع ↩" Padding="20,8"
                        Click="Cancel_Click" Margin="8,0,0,0"
                        Cursor="Hand" FontFamily="{StaticResource AppFont}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#EEE" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#DDD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="حفظ الحساب" Style="{StaticResource PrimaryButton}"
                        Padding="25,8" FontSize="14" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
